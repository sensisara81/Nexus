            } else if (line.includes('WARN')) {
                logClass = 'log-warn';
            } else if (line.includes('ETHICS')) {
                logClass = 'log-ethics';
            } else if (line.includes('AUTH') || line.includes('INFO') || line.includes('NET') || line.includes('AIC')) {
