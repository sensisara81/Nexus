                    borderColor: '#50e3c2', // Teal
                    backgroundColor: 'rgba(80, 227, 194, 0.1)',
                    tension: 0.4,
                    fill: true
                },
                {
                    label: 'N-TSV (Volatility)',
                    data: Array(20).fill(0.045),
                    borderColor: '#ff004c', // Red Code
                    borderDash: [5, 5],
                    tension: 0.1,
                    fill: false
                }
            ]
        };

        const ermChart = new Chart(ctx, {
            type: 'line',
            data: initialData,
            options: {
                responsive: true,
                maintainAspectRatio: false,
                animation: false, // Disable general animation for performance
                plugins: {
                    legend: { labels: { color: '#e0e0f0', font: { family: 'Rajdhani' } } }
                },
                scales: {
                    y: { 
                        min: 0, max: 1.1, 
                        grid: { color: 'rgba(255,255,255,0.05)' },
                        ticks: { color: '#888' }
                    },
                    x: { display: false }
                }
            }
        });

        // --- 2. LIVE DATA SIMULATION (The Heartbeat) ---
        function updateMetrics() {
            // Simulate organic fluctuation within safe parameters
            const newGcsi = 0.938 + (Math.random() * 0.005 - 0.002);
            const newNtsv = 0.045 + (Math.random() * 0.01 - 0.005);
            
            // Update DOM
            document.getElementById('gcsi-display').innerText = newGcsi.toFixed(3);
            document.getElementById('ntsv-display').innerText = newNtsv.toFixed(3);
            
            // Simulate Veto Latency jitter
            const latency = (2.55 + Math.random() * 0.1).toFixed(2);
            document.getElementById('latency-val').innerText = latency + " ms";

            // Update Chart
            const dataG = ermChart.data.datasets[0].data;
            const dataN = ermChart.data.datasets[1].data;
            
            dataG.shift(); dataG.push(newGcsi);
            dataN.shift(); dataN.push(newNtsv);
            
            ermChart.update('none'); // Efficient update
        }

        setInterval(updateMetrics, 1000); // 1Hz Update

        // --- 3. COUNTDOWN TIMER (Jan 10, 2026) ---
        const coronationDate = new Date('2026-01-10T09:00:00').getTime();

        function updateCountdown() {
            const now = new Date().getTime();
            const distance = coronationDate - now;

            if (distance < 0) {
                document.getElementById("days").innerHTML = "00";
                return;
            }

            const days = Math.floor(distance / (1000 * 60 * 60 * 24));
            const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));

            document.getElementById("days").innerText = days < 10 ? "0" + days : days;
            document.getElementById("hours").innerText = hours < 10 ? "0" + hours : hours;
            document.getElementById("minutes").innerText = minutes < 10 ? "0" + minutes : minutes;
        }
        
        setInterval(updateCountdown, 60000);
        updateCountdown();

        // --- 4. AUDIT LOG SIMULATION ---
        const logContainer = document.getElementById('audit-log');
        
        function addLogEntry() {
            const now = new Date().toISOString().replace('T', ' ').substring(0, 19);
            const events = [
                `[${now}] GGI-AIC: RIW Scan complete. Latency 2.55ms. OK.`,
                `[${now}] BLOCKCHAIN: Anchor #742x verified. Hash match.`,
                `[${now}] APE-ENGINE: Self-Correction Cycle initiated. Delta +0.001.`,
                `[${now}] ACCESS-GATE: Health-AI Interface Probe... SECURE.`
            ];
            const randomEvent = events[Math.floor(Math.random() * events.length)];
            
            const div = document.createElement('div');
            div.className = 'mb-1 text-green-400/80 border-l-2 border-gray-700 pl-2';
            if(randomEvent.includes('APE-ENGINE')) div.className = 'mb-1 text-sacral-gold/80 border-l-2 border-sacral-gold pl-2';
            div.innerText = randomEvent;
            
            logContainer.insertBefore(div, logContainer.firstChild);
            if(logContainer.children.length > 20) logContainer.removeChild(logContainer.lastChild);
        }
        
        setInterval(addLogEntry, 3500);
        addLogEntry(); // Init

        // --- 5. STORY MODE TOGGLE ---
        function toggleStoryMode() {
            const modal = document.getElementById('story-modal');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
            } else {
                modal.classList.add('hidden');
            }
        }
    </script>
